1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,8,0,0
PRODUCTVERSION 0,8,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "ShaurMeaw"
      VALUE "FileDescription", "ShaurMeaw - Deadlock Launcher"
      VALUE "FileVersion", "0.8.0"
      VALUE "InternalName", "ShaurMeaw"
      VALUE "LegalCopyright", "Copyright (c) 2026 ShaurMeaw"
      VALUE "OriginalFilename", "ShaurMeaw.exe"
      VALUE "ProductName", "ShaurMeaw"
      VALUE "ProductVersion", "0.8.0"
      VALUE "Comments", "Custom Deadlock launcher and config manager"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
